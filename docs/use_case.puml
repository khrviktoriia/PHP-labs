@startuml
left to right direction
skinparam packageStyle rectangle

actor "Гість\n(Guest)" as Guest
actor "Покупець\n(Customer)" as Customer
actor "Адміністратор\n(Admin)" as Admin

Guest <|-- Customer

rectangle "Інтернет-магазин (Laravel)" {
  usecase "Перегляд каталогу товарів" as UC_Browse
  usecase "Пошук та фільтрація" as UC_Search
  usecase "Реєстрація в системі" as UC_Register
  
  usecase "Авторизація (Login)" as UC_Login
  usecase "Управління кошиком" as UC_Cart
  usecase "Оформлення замовлення" as UC_Checkout
  usecase "Оплата замовлення" as UC_Pay
  usecase "Застосування промокоду" as UC_Promo
  usecase "Перегляд історії замовлень" as UC_History

  usecase "Управління товарами (CRUD)" as UC_ManageProducts
  usecase "Зміна статусу замовлення" as UC_ManageOrders
  usecase "Генерація звітів продажів" as UC_Reports
}

Guest -- UC_Browse
Guest -- UC_Search
Guest -- UC_Register

Customer -- UC_Cart
Customer -- UC_Checkout
Customer -- UC_History
Customer -- UC_Login

Admin -- UC_Login
Admin -- UC_ManageProducts
Admin -- UC_ManageOrders
Admin -- UC_Reports

UC_Checkout ..> UC_Pay : <<include>>
UC_Checkout ..> UC_Login : <<include>>
UC_Promo ..> UC_Checkout : <<extend>>
UC_Search ..> UC_Browse : <<extend>>

@enduml
